{
  "name": "cloudrive",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @cloudrive/web dev",
    "dev:server": "pnpm --filter @cloudrive/server dev",
    "dev:docs": "pnpm --filter @cloudrive/docs dev",
    "build:web": "pnpm --filter @cloudrive/web build",
    "build:server": "pnpm --filter @cloudrive/server build",
    "build:docs": "pnpm --filter @cloudrive/docs build",
    "prebuild": "npm-run-all format lint",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "clean": "pnpm -r clean",
    "doctor": "npx react-doctor@latest",
    "release": "release-it",
    "release:prepare": "release-it --ci --no-git.tag --no-git.push --no-github.release",
    "release:publish": "release-it --ci --no-increment --no-git.commit --no-git.push --github.release",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "12.0.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "release-it": "21.1.1",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24.0"
  },
  "packageManager": "pnpm@11.10.0"
}
