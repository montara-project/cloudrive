{
  "name": "cloudrive",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @cloudrive/web dev",
    "dev:app": "pnpm --filter @cloudrive/app dev",
    "dev:server": "pnpm --filter @cloudrive/server dev",
    "build:web": "pnpm --filter @cloudrive/web build",
    "build:app": "pnpm --filter @cloudrive/app build",
    "build:server": "pnpm --filter @cloudrive/server build",
    "start:web": "pnpm --filter @cloudrive/web start",
    "start:app": "pnpm --filter @cloudrive/app start",
    "deploy:web": "pnpm --filter @cloudrive/web deploy",
    "deploy:app": "pnpm --filter @cloudrive/app deploy",
    "prebuild": "npm-run-all format lint",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "clean": "pnpm -r clean",
    "doctor": "npx react-doctor@latest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24.0"
  },
  "packageManager": "pnpm@11.10.0"
}
