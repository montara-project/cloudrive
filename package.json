{
  "name": "cloudrive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @cloudrive/web dev",
    "dev:server": "pnpm --filter @cloudrive/server dev",
    "build:web": "pnpm --filter @cloudrive/web build",
    "build:server": "pnpm --filter @cloudrive/server build",
    "start:web": "pnpm --filter @cloudrive/web start",
    "deploy:web": "pnpm --filter @cloudrive/web deploy",
    "prebuild": "npm-run-all fmt lint",
    "build": "pnpm -r run build",
    "lint": "oxlint",
    "lint:init": "oxlint --init",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:init": "oxfmt --init",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0"
  }
}
