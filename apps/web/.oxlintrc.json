{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "jsx-a11y",
    "promise",
    "node",
    "import"
  ],
  "jsPlugins": ["eslint-plugin-perfectionist"],
  "rules": {
    "perfectionist/sort-imports": [
      "error",
      {
        "type": "natural",
        "order": "asc"
      }
    ],
    // JSX A11y
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/heading-has-content": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/role-has-required-aria-props": "off",
    "jsx-a11y/no-autofocus": "off",
    // React
    "react/no-children-prop": "off"
  },
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {},
  "overrides": [
    {
      "files": ["apps/admin-web/**", "apps/app-web/**", "apps/main-web/**"],
      "plugins": ["typescript", "unicorn", "react", "react-perf", "jsx-a11y", "promise", "import"],
      "env": {
        "browser": true,
        "es2024": true
      }
    },
    {
      "files": ["apps/server/**"],
      "env": {
        "node": true,
        "es2024": true
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.vinext/**",
    "**/.next/**",
    "**/coverage/**",
    "**/*.d.ts"
  ]
}
