{
  "name": "@cloudrive/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "npm-run-all fmt lint:fix typecheck",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "pnpm run build && pnpm run start",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "lint": "oxlint",
    "lint:init": "oxlint --init",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:init": "oxfmt --init",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.7",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint-plugin-perfectionist": "^5.11.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=24.0"
  },
  "packageManager": "pnpm@11.10.0"
}
