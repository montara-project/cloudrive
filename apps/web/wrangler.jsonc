{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudrive-web",
  "compatibility_date": "2026-09-13",
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": true,
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cloudrive.us.ci",
      "zone_name": "cloudrive.us.ci",
      "custom_domain": true,
    },
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.cloudrive.us.ci",
    "NEXT_PUBLIC_OSM_API_URL": "https://nominatim.openstreetmap.org",
    "BETTER_AUTH_URL": "https://cloudrive.us.ci",
  },
}
