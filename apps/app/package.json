{
  "name": "@cloudrive/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "npm-run-all format lint:fix typecheck",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "pnpm run build && pnpm run start",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
