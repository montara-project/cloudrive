# Machine
MACHINE_ID=1

# App
DEBUG=true
ENV=development
PORT=8080
APP_NAME=cloudrive
APP_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Default admin user, seeded at startup when set (format email:password;
# password min 8 chars). The password is only used on first creation.
SUPER_USER=your@email.com:yourpassword

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8080

# Database
DB_DSN=postgres://postgres:postgres@localhost:5432/gofi?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_DEBUG_TO_EMAIL=

# Google (used by Authula's OAuth2 plugin; the callback URL is derived from SERVER_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3
S3_CLIENT_ID=
S3_CLIENT_SECRET=
S3_REGION=
S3_ENDPOINT=
S3_TOKEN=

# Storage provider credential vault: comma-separated "key_id:base64" entries
# (32-byte AES-256 keys). The FIRST entry encrypts new credentials; later
# entries are previous keys kept only for decryption during rotation.
# Generate a key with: openssl rand -base64 32
STORAGE_CREDENTIALS_KEYS=v1:REPLACE_WITH_openssl_rand_base64_32
