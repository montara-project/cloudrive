# Machine
MACHINE_ID=1

# App
DEBUG=true
ENV=development
PORT=8080
APP_NAME=cloudrive
APP_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
SUPER_USER=your@email.com:yourpassword

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8080

# Database
DB_DSN=postgres://postgres:postgres@localhost:5432/gofi?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_DEBUG_TO_EMAIL=

# Google (used by Authula's OAuth2 plugin; the callback URL is derived from SERVER_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3
S3_CLIENT_ID=
S3_CLIENT_SECRET=
S3_REGION=
S3_ENDPOINT=
S3_TOKEN=
